---
config:
    layout: elk
---
erDiagram
    USERS }|--o{ ROLES : "has"

    USERS |o--o{ RESERVATION : "books (client)"
    USERS |o--o{ RESERVATION : "manages (admin)"
    USERS |o--o{ ORDER : "places (client)"
    USERS |o--o{ ORDER : "services (waiter)"

    RESERVATION }o--|{ TABLE : "reserves"
    RESERVATION |o--o| ORDER : "originates (pre-order)"

    ORDER }o--o{ TABLE : "occupies (dine in)"

    ORDER ||--|{ MENU_ORDER : "contains (min 1)"
    MENU_ITEM ||--o{ MENU_ORDER : "ordered as"

    USERS {
        int id PK
        string name
        string phone
        string password_hash
    }

    ROLES {
        int id PK
        string role "CLIENT | ADMIN | WAITER | CHEF"
    }

    TABLE {
        int id PK
        int table_number
        int capacity
        string status "FREE | OCCUPIED | RESERVED"
    }

    RESERVATION {
        int id PK
        int client_id FK "Null"
        int admin_id FK "Null"
        datetime start_time
        datetime end_time
        string status "CONFIRMED | SEATED | CANCELLED"
    }

    ORDER {
        int id PK
        int client_id FK "Null for guest"
        int waiter_id FK "Null for takeaway"
        int reservation_id FK "Null"
        string order_type "DINE_IN | TAKEAWAY"
        string status "ACTIVE | COOKING | COMPLETED | CANCELLED"
        decimal total_price "intermediate check cost"
        datetime created_at
    }

    MENU_ITEM {
        int id PK
        string title
        decimal price
        bool is_available
        int cooking_time "minutes"
    }

    MENU_ORDER {
        int id PK
        int order_id FK
        int menu_item_id FK
        int quantity
        decimal price_at_order "price snapshot"
    }