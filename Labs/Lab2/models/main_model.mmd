flowchart LR
    %% Актори системи
    User["Зареєстрований користувач"]
    Client["Клієнт"]
    Admin["Адміністратор"]
    Waiter["Офіціант"]
    Chef["Кухар"]
    Guest["Гість"]

    %% Узагальнення зареєстрованих ролей
    Client --> User
    Admin --> User
    Waiter --> User
    Chef --> User

    subgraph Auth ["Автентифікація та доступ"]
      UC0(["Авторизуватися в системі"])
    end

    subgraph System1 ["Управління посадкою та бронюванням"]
      UC1_1(["Забронювати стіл (до 3 столів)"])
      UC1_2(["Переглядати інтерактивну карту залу"])
      UC1_3(["Скасувати або перенести бронювання"])
      UC1_4(["Оперативна посадка гостей за живою чергою"])
      UC1_8(["Отримати нагадування про візит"])
    end

    subgraph System2 ["Оформлення та редагування замовлень"]
      UC2_1(["Сформувати замовлення в залі"])
      UC2_2(["Переглянути проміжну вартість чека"])
      UC2_3(["Редагувати склад активного замовлення"])
      UC2_4(["Оформити попереднє замовлення (Pre-order)"])
      UC2_5(["Оформити замовлення 'із собою' (Takeaway)"])
      UC2_6(["Підтвердити замовлення"])
    end

    subgraph System3 ["Підсистема оплати"]
      UC3_Pay(["Оплатити замовлення"])
