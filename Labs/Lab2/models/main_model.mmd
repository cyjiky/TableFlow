      UC4_7(["Переглядати денну статистику кухні"])
    end

    %% Загальний прецедент зареєстрованого користувача
    User --> UC0

    %% Зв'язки: CLIENT
    Client --> UC1_1
    Client --> UC1_3
    Client --> UC2_1
    Client --> UC2_3
    Client --> UC2_4
    Client --> UC3_1
    Client --> UC3_2
    Client --> UC4_1

    %% Зв'язки: ADMIN
    Admin --> UC1_1
    Admin --> UC1_2
    Admin --> UC1_3
    Admin --> UC1_4
    Admin --> UC4_7

    %% Зв'язки: WAITER
    Waiter --> UC2_1
    Waiter --> UC2_3
    Waiter --> UC3_2
    Waiter --> UC3_3
    Waiter --> UC4_1

    %% Зв'язки: GUEST
    Guest --> UC2_5
    Guest --> UC3_1
    Guest --> UC3_3

    %% Зв'язки: CHEF
    Chef --> UC4_2
    Chef --> UC4_3
    Chef --> UC4_4
    Chef --> UC4_5
    Chef --> UC4_7

    %% Зв'язки include/extend: Підсистема 1
    UC1_4 -.->|"<<include>>"| UC1_2
    UC1_3 -.->|"<<extend>>"| UC1_1
    UC1_8 -.->|"<<extend>>"| UC1_1

    %% Зв'язки include/extend: Підсистема 2
    UC2_1 -.->|"<<include>>"| UC2_2
    UC2_1 -.->|"<<include>>"| UC2_6
    UC2_5 -.->|"<<include>>"| UC2_2
    UC2_5 -.->|"<<include>>"| UC2_6
    UC2_4 -.->|"<<extend>> (за наявності броні)"| UC2_1
    UC2_3 -.->|"<<extend>> (статус ACTIVE)"| UC2_1

    %% Зв'язки include/extend/generalization: Підсистема 3
    UC3_1 --> UC3_Pay
    UC3_2 --> UC3_Pay
    UC3_3 --> UC3_Pay
    UC3_1 -.->|"<<include>>"| UC3_5
    UC3_4 -.->|"<<extend>>"| UC3_Pay

    %% Зв'язки include/extend: Підсистема 4
    UC4_1 -.->|"<<include>>"| UC4_2
    UC4_3 -.->|"<<extend>>"| UC4_2