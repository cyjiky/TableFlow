      UC3_4(["Застосувати подарунковий сертифікат"])
      UC3_5(["Зберегти електронний чек"])
    end

    subgraph System4 ["Комунікація між залом та кухнею"]
      UC4_1(["Передати підтверджене замовлення на кухню"])
      UC4_2(["Переглядати чергу замовлень на екрані"])
      UC4_3(["Отримувати сповіщення про зміни або скасування"])
