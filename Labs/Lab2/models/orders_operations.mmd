---
config:
    layout: elk
---
flowchart LR
    %% Актори
    User["Зареєстрований користувач"]
    Client["Клієнт"]
    Waiter["Офіціант"]
    Guest["Гість"]

    %% Узагальнення акторів
    Client --> User
    Waiter --> User

    subgraph Auth ["Автентифікація"]
      UC0(["Авторизуватися в системі"])
    end

    subgraph System2 ["Оформлення та редагування замовлень"]
      UC2_1(["Сформувати замовлення в залі"])
      UC2_2(["Переглянути проміжну вартість чека"])
      UC2_3(["Редагувати склад активного замовлення"])
      UC2_4(["Оформити попереднє замовлення (Pre-order)"])
      UC2_5(["Оформити замовлення 'із собою' (Takeaway)"])
      UC2_6(["Підтвердити замовлення"])
    end

    %% Загальний прецедент зареєстрованого користувача
    User --> UC0

    %% Зв'язки акторів з прецедентами
    Client --> UC2_1
    Client --> UC2_3
    Client --> UC2_4

    Waiter --> UC2_1
    Waiter --> UC2_3

    Guest --> UC2_5

    %% Include зв'язки
    UC2_1 -.->|"<<include>>"| UC2_2
    UC2_1 -.->|"<<include>>"| UC2_6

    UC2_5 -.->|"<<include>>"| UC2_2
    UC2_5 -.->|"<<include>>"| UC2_6

    %% Extend зв'язки
    UC2_4 -.->|"<<extend>> (за наявності броні)"| UC2_1
    UC2_3 -.->|"<<extend>> (статус ACTIVE)"| UC2_1