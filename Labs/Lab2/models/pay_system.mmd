flowchart LR
    %% Актори
    User["Зареєстрований користувач"]
    Client["Клієнт"]
    Waiter["Офіціант"]
    Guest["Гість"]

    %% Узагальнення акторів
    Client --> User
    Waiter --> User

    subgraph Auth ["Автентифікація"]
      UC0(["Авторизуватися в системі"])
    end

    subgraph System3 ["Підсистема оплати"]
      UC3_Pay(["Оплатити замовлення"])
      UC3_1(["Оплатити замовлення онлайн"])
      UC3_2(["Розрахувати гостей у залі (готівка / термінал)"])
      UC3_3(["Оплатити Takeaway готівкою за кодом"])
      UC3_4(["Застосувати подарунковий сертифікат"])
      UC3_5(["Зберегти електронний чек"])
    end

    %% Загальний прецедент зареєстрованого користувача
    User --> UC0

    %% Зв'язки акторів з прецедентами
    Client --> UC3_1
    Client --> UC3_2

    Waiter --> UC3_2
    Waiter --> UC3_3

    Guest --> UC3_1
    Guest --> UC3_3

    %% Узагальнення способів оплати
    UC3_1 --> UC3_Pay
    UC3_2 --> UC3_Pay
    UC3_3 --> UC3_Pay

    %% Include / Extend зв'язки
    UC3_1 -.->|"<<include>>"| UC3_5
    UC3_4 -.->|"<<extend>>"| UC3_Pay
