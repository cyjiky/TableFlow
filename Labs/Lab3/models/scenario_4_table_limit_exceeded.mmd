sequenceDiagram
    actor User as Client / Admin
    participant ClientApp as ClientApp
    participant ReservationService as ReservationService
    participant RESERVATION as RESERVATION
    participant TABLE as TABLE

    User->>ClientApp: submitManualReservation(date, time, guests_count, table_ids=[1, 2, 3, 4])
    activate ClientApp

    ClientApp->>ReservationService: createManualReservation(client_id, admin_id, start_time, end_time, guests_count, table_ids=[1, 2, 3, 4])
    activate ReservationService

    ReservationService->>ReservationService: validateTableLimit(table_ids)

    alt Кількість обраних столів перевищує ліміт (count(table_ids) > 3)
        ReservationService-->>ClientApp: LimitExceededError("Максимальна кількість столів для одного бронювання: 3")
    else Кількість обраних столів у межах ліміту (1 <= count(table_ids) <= 3)
        ReservationService->>RESERVATION: getReservedTableIds(start_time, end_time)
        activate RESERVATION
        RESERVATION-->>ReservationService: reserved_table_ids
        deactivate RESERVATION

        ReservationService->>TABLE: findAvailableTables(guests_count, reserved_table_ids)
        activate TABLE
        TABLE-->>ReservationService: availableTables
        deactivate TABLE

        ReservationService-->>ClientApp: tablesValidated(availableTables)
    end

    deactivate ReservationService
    ClientApp-->>User: Відображення помилки "Максимальна кількість столів для одного бронювання: 3"
    deactivate ClientApp
