sequenceDiagram
    actor Client as Client
    participant ClientApp as ClientApp
    participant ReservationService as ReservationService
    participant RESERVATION as RESERVATION
    participant TABLE as TABLE
    participant NotificationService as NotificationService

    Client->>ClientApp: submitAutoReservation(date, time, guests_count)
    activate ClientApp

    ClientApp->>ReservationService: createAutoReservation(client_id, start_time, end_time, guests_count)
    activate ReservationService

    ReservationService->>RESERVATION: getReservedTableIds(start_time, end_time)
    activate RESERVATION
    RESERVATION-->>ReservationService: reserved_table_ids
    deactivate RESERVATION

    ReservationService->>TABLE: findAvailableTables(guests_count, reserved_table_ids)
    activate TABLE
    TABLE-->>ReservationService: availableTables (status="FREE", 1..3 tables)
    deactivate TABLE

    ReservationService->>RESERVATION: saveReservation(client_id, admin_id=null, start_time, end_time, table_ids, status="CONFIRMED")
    activate RESERVATION
    RESERVATION-->>ReservationService: reserv_id
    deactivate RESERVATION

    loop Для кожного підібраного столу з availableTables (від 1 до 3 столів)
        ReservationService->>TABLE: updateTableStatus(table_id, status="RESERVED")
        activate TABLE
        TABLE-->>ReservationService: statusUpdated
        deactivate TABLE
    end

    opt Надсилання Push / SMS підтвердження клієнту
        ReservationService->>NotificationService: sendConfirmation(client_id, reserv_details)
        activate NotificationService
        NotificationService-->>Client: Push / SMS підтвердження бронювання
        NotificationService-->>ReservationService: confirmationSent
        deactivate NotificationService
    end

    ReservationService-->>ClientApp: reservationConfirmed(reserv_details)
    deactivate ReservationService

    ClientApp-->>Client: Відображення підтвердження та деталей бронювання
    deactivate ClientApp
